# Hosted HTTP service
HOST=127.0.0.1
PORT=8787
AMBIENT_ADAPTER=demo
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=info

# Direct local companion adapter
AMBIENTCTL_PATH=/Applications/Project Ambient.app/Contents/Resources/ambientctl
AMBIENTCTL_TIMEOUT_MS=8000

# Optional outbound device bridge (hosted service)
BRIDGE_ADMIN_TOKEN=replace-with-a-separate-long-random-token
BRIDGE_STORE_PATH=./data/bridge-state.json
# Runtime URL: use the dedicated, least-privilege login role. It must not own or migrate objects.
POSTGRES_URL=postgresql://ambient_runtime.mbcxfyekqyexpqshamwq:percent-encoded-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
# One-shot migration only: keep this owner URL out of the web-service environment.
MIGRATION_DATABASE_URL=postgresql://migration-owner.mbcxfyekqyexpqshamwq:percent-encoded-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
AMBIENT_RUNTIME_DB_ROLE=ambient_runtime
# Set these with AMBIENT_ADAPTER=remote after enrolling one device.
AMBIENT_DEVICE_ID=device_replace_me

# Outbound Mac device agent
AMBIENT_BRIDGE_URL=https://ambient-api.example.com
AMBIENT_DEVICE_TOKEN=amb_dev_replace_me
AMBIENT_BRIDGE_POLL_MS=1500
