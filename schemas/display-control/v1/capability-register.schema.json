{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-ambient/schemas/display-control/v1/capability-register.schema.json",
  "title": "Display control capability register (v1)",
  "description": "Machine-checkable parity register for the BetterDisplay-class display-management expansion, frozen against BetterDisplay 4.3.6 (build 50119). Every comparator feature is exactly one row with an explicit disposition. Fail-closed: a row that cannot prove a supported disposition must carry a lower one, and the register never carries tracker credit fields.",
  "type": "object",
  "required": ["schemaVersion", "registerVersion", "publicationStatus", "retrievedAt", "launchGate", "baselines", "watchlist", "cleanRoomBoundary", "requiredDomains", "evidenceCatalog", "rowCount", "rows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "registerVersion": { "type": "string", "minLength": 1 },
    "publicationStatus": { "enum": ["draft-unpublished", "review", "accepted"] },
    "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "launchGate": {
      "type": "object",
      "required": ["fullReplacementClaim", "policy"],
      "additionalProperties": false,
      "properties": {
        "fullReplacementClaim": { "type": "boolean" },
        "policy": { "type": "string", "minLength": 40 }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "product", "version", "build", "bundleId", "released", "tagCommit", "landingCommit", "sourceURL"],
        "additionalProperties": false,
        "properties": {
          "label": { "const": "stable" },
          "product": { "const": "BetterDisplay" },
          "version": { "const": "4.3.6" },
          "build": { "const": "50119" },
          "bundleId": { "const": "pro.betterdisplay.BetterDisplay" },
          "released": { "const": "2026-08-11" },
          "tagCommit": { "const": "046b59f8c04e8b46872ee270f5cee76cc1ef1803" },
          "landingCommit": { "const": "c71b73d5e024c793e8df7be2742017a81599b0cc" },
          "sourceURL": { "const": "https://github.com/waydabber/BetterDisplay/releases/tag/v4.3.6" }
        }
      }
    },
    "watchlist": { "type": "string", "minLength": 10 },
    "cleanRoomBoundary": { "type": "string", "minLength": 40 },
    "requiredDomains": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domain" }
    },
    "evidenceCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "uri", "retrievedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9-]{2,12}$" },
          "kind": { "enum": ["official-documentation", "apple-documentation", "open-source", "handoff"] },
          "uri": { "type": "string", "minLength": 8 },
          "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "rowCount": { "type": "integer" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "domain": {
      "enum": [
        "discovery-identity", "mode-transactions", "hidpi-custom-modes", "hdr-xdr",
        "color-management", "ddc-hardware-control", "software-dimming-osd", "audio",
        "groups-sync-presets", "virtual-displays", "disconnect-reconnect", "edid",
        "pip-streaming", "network-device-control", "settings-recovery", "control-plane",
        "privacy-security", "accessibility-localization", "updater-support",
        "qualification", "packaging-claims", "policy"
      ]
    },
    "row": {
      "type": "object",
      "required": ["id", "capability", "comparatorTier", "domain", "evidenceRefs", "disposition", "apiBasis", "ownerWorkstream", "implementationStatus", "testBinding", "claimGates"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^BD-[A-Z]{2,6}-[0-9]{3}$" },
        "capability": { "type": "string", "minLength": 3 },
        "comparatorTier": { "enum": ["free", "pro", "cross-cutting"] },
        "domain": { "$ref": "#/$defs/domain" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "disposition": { "enum": ["supported", "experimental", "manual-only", "unavailable", "blocked"] },
        "apiBasis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "ref"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["public-apple-api", "app-local", "mit-licensed-oss", "vendor-network-protocol", "os-undocumented", "private-spi-risk", "physical-process", "none"]
              },
              "ref": { "type": "string", "minLength": 3 }
            }
          }
        },
        "ownerWorkstream": { "type": "string", "pattern": "^WS-DC-0(0[1-9]|1[01])$" },
        "implementationStatus": { "enum": ["unimplemented", "in-progress", "implemented", "qualified"] },
        "testBinding": { "type": "string", "minLength": 3 },
        "claimGates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "opt-in", "consent", "timeout", "kill-switch", "local-auth",
              "accessibility-permission", "screen-recording-permission", "hardware-matrix",
              "m4-resource", "soak", "privacy-review", "security-review", "a11y-review",
              "owner-decision", "adapter-packaging", "rollback-proof"
            ]
          }
        },
        "notes": { "type": "string", "minLength": 3 }
      }
    }
  }
}
